<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS already listens on port 80 on this machine. Copy this file to your IIS
  site root as web.config (or merge the rewrite rule) so http://pc-armin/helix
  forwards to the Helix nginx container on port 8088.

  Requires: URL Rewrite + Application Request Routing (proxy enabled).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Helix nginx gateway" stopProcessing="true">
          <match url="^helix(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8088/helix{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
