server {
    listen 80;
    listen [::]:80;
    server_name _;

    location = /helix {
        return 301 /helix/;
    }

    location /helix/api/ {
        # Variable proxy_pass drops the request URI when a path is inlined —
        # rewrite first, then proxy_pass host only (keeps /api/health/ intact).
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $helix_api_upstream http://${API_HOST}:${API_PORT};
        rewrite ^/helix/api/(.*)$ /api/$1 break;
        proxy_pass $helix_api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        # Live sync: SSE needs no buffering
        proxy_buffering off;
        proxy_cache off;
    }

    location /helix/assets/ {
        alias /usr/share/nginx/html/assets/;
        expires 7d;
        add_header Cache-Control "public, immutable";
    }

    location /helix/ {
        alias /usr/share/nginx/html/;
        try_files $uri $uri/ @helix_spa;
    }

    location @helix_spa {
        root /usr/share/nginx/html;
        rewrite ^ /index.html break;
    }
}
